(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 1.6)
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clearance_class "Logic_Control" (clearance 0.25) (trace_width 0.25))
    ;; COMPLIANCE: Continuous 0.5mm Parallel Guard Ground Tracks Shielding Samson EMA Pulse Lines [0.12]
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
    (clearance_class "Samson_48V_5A_Rail" (clearance 1.2) (trace_width 1.50))
  )

  (net 0 "")
  (net 1 "VCC_48V_TRACTION_STEP")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Samson_Hitch_Axial_Trigger_5us")
  (net 4 "Samson_Hitch_Rotary_Trigger_5us")
  (net 5 "Hitch_Bitter_Coil_Anode")
  (net 6 "Hitch_Bitter_Coil_Cathode")

  ;; --- Component Matrix Placements ---
  
  ;; U1: High-Speed Silicon Carbide Switch Gate (Samson 5-Microsecond Pulse Synchronizer Core) [0.13]
  (module "Housings_SOIC:SOIC-16_3.9x9.9mm_Pitch1.27mm" (layer "F.Cu") (at 50.0 50.0)
    (pad "1" smd rect (at -4.445 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_48V_TRACTION_STEP"))
    (pad "2" smd rect (at -3.175 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Samson_Hitch_Axial_Trigger_5us"))
    (pad "3" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Samson_Hitch_Rotary_Trigger_5us"))
    (pad "4" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Line Left [0.12]
    (pad "5" smd rect (at 0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Line Right [0.12]
    (pad "15" smd rect (at -3.175 2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "Hitch_Bitter_Coil_Anode"))
    (pad "16" smd rect (at -4.445 2.7) (size 0.6 1.5) (layers "F.Cu") (net 6 "Hitch_Bitter_Coil_Cathode"))
    (net_class "Samson_48V_5A_Rail" (pins "15" "16"))
  )
)
